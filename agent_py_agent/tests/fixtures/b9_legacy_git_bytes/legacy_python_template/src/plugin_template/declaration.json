{
  "plugin_id": "text-count-python",
  "summary": "Python 只读文本统计模板",
  "entry_module": "plugin_template",
  "default_action": "count",
  "actions": [
    {
      "name": "count", "summary": "统计输入文本的 Unicode 字符数",
      "arguments": [
        {"name": "text", "summary": "待统计文本", "options": [], "value_type": "string", "required": true,
         "multiple": false, "default": null, "choices": [], "path": false}
      ],
      "kind": "tool", "target": "count_text", "available": true
    }
  ],
  "tools": [
    {
      "name": "count_text", "description": "统计输入文本的 Unicode 码点数；不读取文件、不联网、不写入。",
      "requested_effect": "read_only",
      "input_schema": {
        "type": "object", "properties": {"text": {"type": "string", "maxLength": 4096}},
        "required": ["text"], "additionalProperties": false
      }
    }
  ],
  "settings_schema": {"type": "object", "properties": {}, "additionalProperties": false}
}
