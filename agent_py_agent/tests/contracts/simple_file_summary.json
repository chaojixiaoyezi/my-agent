{
  "name": "simple_file_summary",
  "artifacts": {
    "required": [
      {
        "path": "output.md",
        "min_size": 20,
        "required_sections": [
          "Summary",
          "Checked Files"
        ]
      }
    ]
  },
  "tools": {
    "required_calls": [
      "read_file",
      "write_file"
    ]
  },
  "final_status": {
    "allow_succeeded_only_if": [
      "artifact_exists",
      "artifact_non_empty",
      "required_sections_present",
      "required_tool_calls_present"
    ]
  }
}
