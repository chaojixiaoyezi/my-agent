{
  "plugin_id": "drama-text-a",
  "version": "0.5.4",
  "summary": "从原文依据形成短剧文本和分镜资料",
  "capability": {
    "description": "适用于故事改编、单集剧本、场次与镜头设计；保留原文依据和省略说明，不生成媒体。",
    "keywords": [
      "短剧",
      "漫剧",
      "故事改编",
      "剧本",
      "分镜",
      "文本依据"
    ],
    "entry_document": "CAPABILITY.md",
    "verification": {
      "deliverables": [
        {
          "id": "delivery",
          "path_patterns": [
            "**/*.json"
          ],
          "required": true,
          "field_match": {
            "format": "json",
            "field": "schema",
            "equals": [
              "drama_text_delivery.v3"
            ]
          }
        }
      ],
      "verifiers": [
        {
          "id": "check-delivery",
          "member": "scripts/check_delivery.py",
          "runtime": "python",
          "applies_to": "delivery",
          "args": [
            "--delivery",
            "{target}",
            "--host-json"
          ],
          "timeout_seconds": 20,
          "inputs": [
            {
              "flag": "--source",
              "source": "task_input",
              "path_patterns": [
                "**/*.json"
              ],
              "required": true,
              "field_match": {
                "format": "json",
                "field": "schema",
                "equals": [
                  "drama_text_source.v1"
                ]
              }
            }
          ]
        }
      ],
      "input_policy": "preserve_originals"
    }
  },
  "files": [
    {
      "path": "CAPABILITY.md"
    },
    {
      "path": "LICENSE"
    },
    {
      "path": "PROVENANCE.md"
    },
    {
      "path": "licenses/drama-skills-LICENSE"
    },
    {
      "path": "methods/review.md"
    },
    {
      "path": "methods/review-source.md"
    },
    {
      "path": "methods/review-continuity.md"
    },
    {
      "path": "methods/review-delivery.md"
    },
    {
      "path": "methods/workflow.md"
    },
    {
      "path": "methods/visible-characters.md"
    },
    {
      "path": "resources/example-delivery.json"
    },
    {
      "path": "resources/example-source.json"
    },
    {
      "path": "scripts/check_delivery.py"
    },
    {
      "path": "templates/delivery.json"
    },
    {
      "path": "templates/review.md"
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
