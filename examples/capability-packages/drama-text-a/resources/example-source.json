{
  "schema": "drama_text_source.v1",
  "title": "雨夜书店",
  "target_seconds": 60,
  "passages": [
    {
      "id": "P01",
      "text": "打烊前，店员发现门口放着一本被雨淋湿的旧书。"
    },
    {
      "id": "P02",
      "text": "赶车人折返找书，书页里夹着写给远方孩子的便条。"
    },
    {
      "id": "P03",
      "text": "店员把书装进防水袋，赶车人在末班车到站前接过它。"
    }
  ]
}
