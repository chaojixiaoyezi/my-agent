{
  "plugin_id": "drama-workflow-b",
  "version": "0.3.1",
  "summary": "核对短剧制作资料的连续性与交接",
  "capability": {
    "description": "适用于人物、场景、道具、分集、对白节拍和分镜的结构化工作流与报告；参考图只作计划，媒体未验证。",
    "keywords": [
      "短剧",
      "工作流",
      "人物设定",
      "道具",
      "分镜",
      "连续性",
      "制作报告"
    ],
    "entry_document": "CAPABILITY.md",
    "verification": {
      "deliverables": [
        {
          "id": "project",
          "path_patterns": [
            "**/*.json"
          ],
          "required": true,
          "field_match": {
            "format": "json",
            "field": "schema",
            "equals": [
              "drama_workflow_project.v1"
            ]
          }
        }
      ],
      "verifiers": [
        {
          "id": "check-project",
          "member": "scripts/check_continuity.py",
          "runtime": "python",
          "applies_to": "project",
          "args": [
            "--project",
            "{target}",
            "--host-json"
          ],
          "timeout_seconds": 20,
          "inputs": [
            {
              "flag": "--handoff",
              "source": "turn_output",
              "path_patterns": [
                "**/*.json"
              ],
              "required": false,
              "field_match": {
                "format": "json",
                "field": "schema",
                "equals": [
                  "drama_workflow_handoff.v2"
                ]
              }
            },
            {
              "flag": "--baseline-project",
              "source": "task_input",
              "path_patterns": [
                "**/*.json"
              ],
              "required": false,
              "field_match": {
                "format": "json",
                "field": "schema",
                "equals": [
                  "drama_workflow_project.v1"
                ]
              }
            }
          ]
        }
      ],
      "input_policy": "preserve_originals"
    }
  },
  "files": [
    {
      "path": "CAPABILITY.md"
    },
    {
      "path": "LICENSE"
    },
    {
      "path": "PROVENANCE.md"
    },
    {
      "path": "licenses/shuohao-skills-LICENSE"
    },
    {
      "path": "licenses/shuohao-skills-NOTICE"
    },
    {
      "path": "methods/review.md"
    },
    {
      "path": "methods/workflow.md"
    },
    {
      "path": "resources/example-project.json"
    },
    {
      "path": "scripts/check_continuity.py"
    },
    {
      "path": "templates/handoff.json"
    },
    {
      "path": "templates/project.json"
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
