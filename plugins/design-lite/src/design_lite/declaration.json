{
  "plugin_id": "design-lite",
  "summary": "按模板生成 HTML 设计文件，并修改标题、副标题、颜色",
  "entry_module": "design_lite",
  "default_action": "",
  "actions": [
    {
      "name": "create",
      "summary": "按模板生成设计文件",
      "arguments": [
        {
