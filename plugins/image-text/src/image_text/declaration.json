{
  "plugin_id": "image-text",
  "summary": "对工作区图片做本地 OCR，返回文字和图片元数据",
  "entry_module": "image_text",
  "default_action": "read",
  "actions": [
    {
      "name": "read",
      "summary": "识别图片中的文字",
      "arguments": [
        {
          "name": "path",
          "summary": "工作区图片路径",
          "options": [
            "--path",
            "-p"
          ],
          "value_type": "string",
          "required": true,
          "multiple": false,
          "default": null,
          "choices": [],
          "path": true
        },
        {
          "name": "lang",
          "summary": "tesseract 语言名，如 eng 或 chi_sim+eng",
          "options": [
            "--lang",
            "-l"
          ],
          "value_type": "string",
          "required": false,
          "multiple": false,
          "default": null,
          "choices": [],
          "path": false
        }
      ],
      "kind": "tool",
      "target": "read",
      "available": true
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "用本机 tesseract 对当前工作区的一张 PNG/JPEG/GIF/WebP 图片做本地 OCR，返回全文、逐行文字与外框、置信度和图片宽高/格式/sha256。不做视觉理解：需要理解图片内容时，请让用户在 TUI 用 /attach 附加图片并切换到支持视觉的模型。",
      "requested_effect": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "工作区图片路径"
          },
          "lang": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z_]+(\\+[a-z_]+)*$",
            "description": "tesseract 语言名，只含小写字母、下划线，多语言用 + 连接；缺省用设置 default_lang"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "tesseract_path": {
        "type": "string",
        "maxLength": 4096,
        "default": "",
        "description": "tesseract 可执行文件路径；留空时在 PATH 中查找"
      },
      "default_lang": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z_]+(\\+[a-z_]+)*$",
        "default": "eng",
        "description": "默认 OCR 语言"
      },
      "max_image_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 52428800,
        "default": 10485760,
        "description": "单张图片读取上限（字节）"
      },
      "ocr_timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120,
        "default": 30,
        "description": "单次 OCR 超时秒数，超时终止 tesseract"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
