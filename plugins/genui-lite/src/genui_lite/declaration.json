{
  "plugin_id": "genui-lite",
  "summary": "把结构化数据渲染成表格和条形图，可导出独立 HTML",
  "entry_module": "genui_lite",
  "default_action": "table",
  "skills": [
    "genui-table"
  ],
  "actions": [
    {
      "name": "table",
      "summary": "渲染 Markdown 表格与文字条形图",
